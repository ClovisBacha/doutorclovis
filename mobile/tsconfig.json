{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist-ios", "dist-web", "**/*.test.ts", "scripts"]
}
