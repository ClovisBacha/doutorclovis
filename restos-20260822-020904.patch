+    expect(ondeGrava).toBeGreaterThan(-1);
+    expect(ondeTria).toBeLessThan(ondeGrava);
+    expect(limpo).toContain('desfecho !== "publicavel"');
+    expect(limpo).toContain("recadoDeConteudo(desfecho)");
