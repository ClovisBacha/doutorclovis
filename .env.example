CHAT_MODEL="gemini-2.5-flash"

# E-mails do(s) administrador(es), separados por vírgula. Quem estiver aqui
# enxerga o "Painel do médico" (/painel) e recebe aviso de novos agendamentos.
ADMIN_EMAILS="bachaclovis@gmail.com"

# (Opcional) Envio de e-mail de confirmação de consulta via Resend.
# Crie a chave em https://resend.com (nível gratuito). Sem ela, o agendamento
# continua funcionando, só não dispara e-mail.
RESEND_API_KEY=""
# Remetente. Enquanto não verificar um domínio no Resend, use o padrão abaixo
# (só envia para o e-mail dono da conta Resend).
# Remetente dos e-mails. Nome da PLATAFORMA, nunca de um médico: a mesma conta
# envia e-mail para pacientes de médicos diferentes, e quem assina o conteúdo é
# a moldura (emailLayout), com o nome do médico daquela paciente.
MAIL_FROM="Obstétrica <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
# Consulta Particular — PIX do médico (exibido no portal)
