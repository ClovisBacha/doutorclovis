VITE_VAPID_PUBLIC_KEY=""

# ─────────────────────────────────────────────────────────────
# Push NATIVO (app iOS/Android) — opcional, e separado do Web Push
#
# São dois caminhos diferentes, não um substituindo o outro. O Web Push acima
# atende o navegador; dentro do app o WKWebView do iPhone NÃO TEM Web Push —
# quem entrega é a Apple (APNs) e o Google (FCM). Sem estas chaves o envio
# nativo vira silêncio e nada quebra, igual ao VAPID.
# ─────────────────────────────────────────────────────────────
# iPhone. A chave .p8 sai do portal da Apple (Certificates → Keys → APNs).
# Cole o CONTEÚDO do arquivo; `\n` literal também funciona.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_BUNDLE_ID="br.com.obstetrica.app"
# Por onde COMEÇAR a tentar. Vazio = sandbox, "1" = produção.
#
# Um app cruza tres ambientes na vida, e a maioria erra este aqui:
#   instalado pelo Xcode  → sandbox
#   TestFlight            → PRODUÇÃO  (é a pegadinha: TestFlight não é sandbox)
#   App Store             → produção
#
# Errar não quebra mais nada: o servidor recebe 400 BadDeviceToken e REFAZ o
# envio no outro ambiente sozinho. Isto aqui só decide a ordem — acertar poupa
# uma ida e volta, errar custa latência, não entrega.
APNS_PRODUCTION=""

# Android. Vem do JSON da conta de serviço do Firebase
# (Configurações do projeto → Contas de serviço → Gerar nova chave privada).
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# ─────────────────────────────────────────────────────────────
# Mercado Pago — PIX automático (opcional)
# Sem esta chave, o sistema mostra a chave PIX manual e o paciente clica
# "Marquei o pagamento". Com ela, gera QR Code automático + confirma sozinho.
#
# Setup: mercadopago.com/developers → Credenciais → Access Token (produção)
# Webhook: configurar em MP Developers → Webhooks → URL: https://seusite.com/api/mp-webhook
#          Evento: "Pagamentos"
# ─────────────────────────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Stripe — Assinaturas recorrentes do MÉDICO (só dele; ver o passo 2)
# Pagamento por cartão com renovação automática. Pagou → acesso liberado na
# hora pelo webhook (sem etapa manual).
#
# NÃO existe chave publicável aqui de propósito: o checkout é por REDIRECT
# (Stripe Checkout), então o navegador nunca fala com o Stripe — o `pk_live_…`
# não é usado em lugar nenhum do código.
#
# Setup (uma vez):
#   1. stripe.com → Developers → API keys → Secret key (sk_live_… / sk_test_…)
#   2. Products → crie os produtos e Prices RECORRENTES (BRL).
#
#      SÓ OS PLANOS DO MÉDICO. O Premium da paciente NÃO se vende aqui: ele é
#      canal "app" (ver `src/lib/canal-de-venda.ts`), e o checkout do Stripe É o
#      canal "site" por definição — `createSubscriptionCheckout` recusa antes de
#      falar com o Stripe. Criar esses produtos seria trabalho jogado fora, e
#      pior: daria a impressão de que a paciente pode assinar pelo site.
#
#      Os valores saem de PLAN_PRICE em `src/lib/entitlements.ts`, que é o que o
#      painel MOSTRA ao médico. Preço em dois lugares é a divergência clássica —
#      um sobe, o outro fica, e a tela passa a mentir sobre a própria cobrança.
#      (Este arquivo já disse 197/347 enquanto o código dizia 149/297.)
#
#        - Starter  R$   149/mês
#        - Pro      R$   297/mês
#        - Elite    R$   597/mês
#        - Black    R$ 1.499/mês
#
#      "Clínica" é sob consulta e NÃO tem Price no Stripe, de propósito.
#      As versões anuais são opcionais; sem o Price, o plano anual some da tela.
#
#      Copie cada "Price ID" (price_…) para as variáveis abaixo.
#   3. Developers → Webhooks → Add endpoint:
#        URL: https://www.obstetrica.com.br/api/stripe-webhook
#        Eventos: checkout.session.completed, customer.subscription.created,
#                 customer.subscription.updated, customer.subscription.deleted
#      Copie o "Signing secret" (whsec_…) para STRIPE_WEBHOOK_SECRET.
#   4. Billing → Customer portal → ative (para o botão "Gerenciar assinatura").
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Estas duas ficam VAZIAS: a paciente assina dentro do app, nunca pelo site.
STRIPE_PRICE_QUIZ_MONTHLY=""
STRIPE_PRICE_QUIZ_ANNUAL=""
STRIPE_PRICE_DOCTOR_STARTER_MONTHLY=""
STRIPE_PRICE_DOCTOR_STARTER_ANNUAL=""
STRIPE_PRICE_DOCTOR_PRO_MONTHLY=""
STRIPE_PRICE_DOCTOR_PRO_ANNUAL=""
STRIPE_PRICE_DOCTOR_ELITE_MONTHLY=""
STRIPE_PRICE_DOCTOR_ELITE_ANNUAL=""
STRIPE_PRICE_DOCTOR_BLACK_MONTHLY=""
STRIPE_PRICE_DOCTOR_BLACK_ANNUAL=""
# URL pública do site (usada nos redirects de sucesso/cancelamento do checkout)
SITE_URL="https://www.obstetrica.com.br"

# ─────────────────────────────────────────────────────────────
# Instagram → 100 Sementinhas (opcional)
# A paciente marca @obstetrica.app num Story e ganha 100 🌱 automático.
# Enquanto estas variáveis não existirem, o card nem aparece no app.
# Passo a passo da config na Meta: topo de src/routes/api/instagram-webhook.ts
#   INSTAGRAM_VERIFY_TOKEN — string secreta que você inventa (bate no cadastro do webhook)
#   INSTAGRAM_APP_SECRET   — "App Secret" do app da Meta (valida a assinatura do webhook)
#   INSTAGRAM_PAGE_TOKEN   — token de acesso p/ resolver o @ de quem marcou no Story
# ─────────────────────────────────────────────────────────────
INSTAGRAM_VERIFY_TOKEN=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_PAGE_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Avaliar o app na loja → 100 Sementinhas (opcional)
# Preencha quando publicar o app nas lojas. Enquanto vazio, o card não aparece.
# Basta UMA das duas pra ligar (mostra só os botões das lojas preenchidas).
# ─────────────────────────────────────────────────────────────
PLAY_STORE_URL=""
APP_STORE_URL=""

# ─────────────────────────────────────────────────────────────
# Google Meet / Google Agenda — Teleconsultas (opcional)
# Sem estas chaves, o sistema usa Jitsi como fallback (gratuito).
#
# Com elas, ao abrir a sala o portal cria um evento no Google Agenda com Meet
# embutido e CONVIDA médico + paciente por e-mail (o Google manda o convite).
# Guia passo a passo (como obter o refresh_token): docs/GOOGLE_MEET.md
#   - Escopo necessário: https://www.googleapis.com/auth/calendar.events
#   - (opcional, para o fallback de sala avulsa) .../auth/meetings.space.created
# ─────────────────────────────────────────────────────────────
GOOGLE_MEET_CLIENT_ID=""
GOOGLE_MEET_CLIENT_SECRET=""
GOOGLE_MEET_REFRESH_TOKEN=""

# ─────────────────────────────────────────────────────────────
# WhatsApp Business API (Meta Cloud API) — Agente de IA
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
# ─────────────────────────────────────────────────────────────
# ID do número de telefone (WhatsApp Business Manager → número → Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=""
# Token de acesso permanente (System User no Meta Business Manager)
WHATSAPP_ACCESS_TOKEN=""
# String secreta escolhida por você para verificar o webhook (qualquer string aleatória)
WHATSAPP_VERIFY_TOKEN=""
# Chave Secreta do App (Meta → Configurações do App → Básico → "Chave Secreta do App").
# Valida a assinatura X-Hub-Signature-256 de cada mensagem recebida — sem ela o
# webhook IGNORA todas as mensagens (fail-closed, impede payload forjado).
WHATSAPP_APP_SECRET=""
# Número de telefone em formato E.164, ex: +5531999999999 (exibido no app)
WHATSAPP_DISPLAY_PHONE=""

# Super-admin (dono da plataforma): e-mail com acesso ao console /admin.
# Se vazio, usa o 1º e-mail de ADMIN_EMAILS.
PLATFORM_ADMIN_EMAIL=""

# ─────────────────────────────────────────────────────────────
# Fila de espera — cascata automática (opcional)
# A fila já avança quando alguém abre o app; para avançar também com todos
# offline, aponte um cron para /api/waitlist-tick com este segredo no header
# Authorization: Bearer <valor>. Detalhes no topo de src/routes/api/waitlist-tick.ts.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=""

# DoctorThink (produto do Segundo Cérebro) — consumo REMOTO opcional.
# Se preenchidos E a flag doctorthink_remote estiver ligada, o chat busca o
# cérebro na API DoctorThink standalone; senão, usa o cérebro local (padrão).
DOCTORTHINK_API_URL=""
DOCTORTHINK_API_KEY=""

# URL pública do site (sitemap/SEO). Opcional — padrão: DOCTOR.siteUrl.
VITE_PUBLIC_URL=https://www.obstetrica.com.br
# Modelo de embeddings do cérebro semântico. Opcional — padrão: text-embedding-004.
EMBEDDING_MODEL=text-embedding-004
# Secret do webhook do Mercado Pago (painel MP → Webhooks). Opcional; quando
# presente, a assinatura x-signature passa a ser verificada.
MERCADO_PAGO_WEBHOOK_SECRET=

# ── SOS: aviso automático ao contato de emergência por SMS/WhatsApp ──────────
# Opcional. Recebe POST {"to":"+5531...","text":"..."} com Authorization Bearer
# se o token existir. Aponte para Twilio, Zenvia, WhatsApp Cloud API ou um
# n8n/Zapier no meio. SEM estas variáveis o canal não existe e a tela avisa que
# falta o contato — nunca finge que mandou.
# Modelo aprovado no Meta para o aviso do SOS pelo WhatsApp Cloud API (que já
# está configurado acima em WHATSAPP_*). Sem modelo, o texto livre só chega se
# o contato tiver escrito para o número nas últimas 24h — o que ele nunca fez.
SOS_WA_TEMPLATE=
SOS_WA_TEMPLATE_LANG=pt_BR

SOS_SMS_WEBHOOK_URL=
SOS_SMS_WEBHOOK_TOKEN=

# Conferencia de CRM no conselho (opcional).
#
# O CFM e os CRMs estaduais NAO publicam API oficial. Com estas variaveis
# apontando para um servico de consulta (proprio ou pago), o botao "Conferir no
# conselho" no painel funciona de verdade. Sem elas, a tela diz honestamente que
# a conferencia nao esta ligada — e nunca mostra "verificado".
#
# Contrato esperado: GET {CRM_LOOKUP_URL}?uf=MG&numero=12345
#   200 -> { "nome": "...", "situacao": "Ativo", "especialidade": "..." }
#   404 -> registro nao encontrado
CRM_LOOKUP_URL=""
CRM_LOOKUP_TOKEN=""
