# Chave da API da Anthropic, usada pelo chatbot (src/routes/api/chat.ts).
# Crie em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# (Opcional) Modelo do chatbot. Padrão: claude-haiku-4-5 (rápido e econômico).
# Para mais qualidade: claude-sonnet-4-6 ou claude-opus-4-8.
CHAT_MODEL="claude-haiku-4-5"
