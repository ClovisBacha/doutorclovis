VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:bachaclovis@gmail.com"
# Mesma chave PÚBLICA acima, exposta ao navegador (necessária p/ o app inscrever
