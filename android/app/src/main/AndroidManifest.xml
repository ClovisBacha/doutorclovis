<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- SOS: sem estas duas o WebView NAO entrega coordenada nenhuma, e o
         `navigator.geolocation` da pagina chama o callback de erro. Como o SOS
         trata erro de localizacao como "sai sem a coordenada" (que e o certo
         numa emergencia), a falha ficava INVISIVEL: o aviso chegava ao medico
         dizendo "sem localizacao" e ninguem desconfiava de que o aparelho
         nunca teve chance de responder. Ver `src/lib/localizacao.ts`. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Push: o Android 13+ exige permissao para MOSTRAR notificacao. Sem ela o
         token e registrado, a mensagem chega, e nada aparece na tela. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
